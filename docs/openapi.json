      "title": "Horizon Start",
      "description": "A Monday; the forecast covers that week"
     },
     "focus_day": {
      "type": "integer",
      "maximum": 6.0,
      "minimum": 0.0,
      "title": "Focus Day",
      "description": "Day of the week to return in half-hour detail (0 = Monday)",
      "default": 5
     }
    },
    "type": "object",
    "required": [
